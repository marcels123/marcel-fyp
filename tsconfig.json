{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["app/*"],                      // General root alias for everything inside /app
      "@components/*": ["app/components/*"], // Reusable components (Navbar, Footer, etc.)
      "@account/*": ["app/account/*"],       // Account pages (Profile, Settings)
      "@auth/*": ["app/authentication/*"],   // Authentication pages (Sign-in, Sign-up)
      "@site/*": ["app/site/*"],             // Site content (Landing page, Media pages)
      "@context/*": ["src/context/*"],       // React Context providers
      "@hooks/*": ["src/hooks/*"],           // Custom React hooks
      "@utils/*": ["src/utils/*"],           // Helper functions and API utilities
      "@styles/*": ["src/styles/*"]          // Global and custom styles
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
